# OpenCode Dockerized User Configuration
# 
# This file is auto-generated by 'opencode-dockerized install' but can be edited manually.
# Location: ~/.config/opencode-dockerized/config
#
# Format:
#   setting.<name>=<value>                           # Settings (true/false)
#   mount.<name>=<host_path>:<container_path>[:<mode>]  # Volume mounts
#   env.<name>=<VARIABLE_NAME>                       # Environment variables
#
# Modes: "ro" (read-only, default) or "rw" (read-write)
# Paths: Use ~ for home directory (expanded at runtime)
# Vars: Must be uppercase with underscores, set in host environment
# Values are taken verbatim: do NOT append inline comments after a value
# (e.g. `setting.memory=4g # limit` passes "4g # limit" to docker).

# ============================================
# Settings
# ============================================

# SSH Agent Forwarding
# Enables git over SSH support in the container without sharing actual keys.
# When enabled, this automatically:
#   - Mounts the SSH_AUTH_SOCK socket into the container
#   - Passes the SSH_AUTH_SOCK environment variable
#   - Mounts ~/.ssh/config and known_hosts read-only (host keys/aliases work)
# Private keys (id_*, *.pem, *.key) are never mounted; mounting ~/.ssh is refused.
#
# This is the recommended way to use SSH in the container for git operations.
#
# setting.ssh_agent_support=true

# GnuPG Agent Forwarding
# Enables signing commits/tags (git commit -S) with the keys held by your host
# gpg-agent, without copying any private key into the container.
# When enabled, this automatically:
#   - Mirrors the public keyring (pubring.kbx / public-keys.d) and gpg.conf into
#     the container and mounts it read-write (GPG needs to write lock files),
#     with no-autostart added so the container never starts a keyless local agent
#   - Keeps use-keyboxd and starts keyboxd at boot, so gpg can read hosts whose
#     public keyring lives in the keyboxd database (public-keys.d/)
#   - Mounts the host gpg-agent socket (preferring the restricted
#     S.gpg-agent.extra) and sets GNUPGHOME
# Private keys (private-keys-v1.d) are never mounted or copied. Pinentry runs on
# the host agent, so it is independent of the container's desktop environment.
#
# Run 'opencode-dockerized doctor' inside the container to verify the setup.
#
# setting.gpg_agent_support=false

# Allow falling back to the full-control gpg-agent socket when the restricted
# S.gpg-agent.extra socket is unavailable. NOT recommended: the main socket can
# reconfigure the host agent. Default: false (warn and skip instead).
#
# setting.gpg_allow_main_socket=false

# Launch the host gpg-agent automatically at run time when its socket is
# missing (default: true). Set to false to only warn and never start it.
#
# setting.gpg_autostart_agent=true

# Relay the agent socket through a socket on a normal filesystem when it lives
# on tmpfs (/run/user/<uid>/gnupg), which Docker cannot bind. Requires `socat`
# on the host. Default: true.
#
# setting.gpg_relay=true

# Host Docker socket (opt-in, DISABLED by default)
# Mounting it grants the container full control of the host Docker daemon, which
# is effectively root on the host and defeats the sandbox. Enable it only when
# you need Docker-in-Docker / Testcontainers.
#
# setting.docker_socket=true

# Security policy mode enforced by the mounted security hooks.
#   strict   = every vendored opencode-policy pattern
#   balanced = drop cloud/multi-tenant rules and common dev false positives (default)
#   off      = vendored patterns disabled (built-in backstops still apply)
#
# setting.security_policy=balanced

# Optional container resource limits (docker --memory / --cpus). Empty = no limit.
# setting.memory=4g
# setting.cpus=2

# Secrets file (dotenv KEY=VALUE lines) loaded with docker --env-file.
# Must live under ~/.config/opencode-dockerized/ (never mounted; elsewhere is
# refused). Create with: install -m 600 /dev/null ~/.config/opencode-dockerized/env
# This is the only way user secrets reach the container. Empty = disabled.
# setting.env_file=~/.config/opencode-dockerized/env

# Built-in websearch provider: exa | firecrawl | parallel | tavily | random.
# Empty = ask once in the TUI. The provider API key (e.g. EXA_API_KEY) must be
# in the env file.
# setting.websearch_provider=exa

# TUI theme (built-in, e.g. catppuccin, catppuccin-frappe, catppuccin-macchiato).
# Empty = OpenCode default.
# setting.theme=catppuccin

# ============================================
# Custom Volume Mounts
# ============================================
# Syntax: mount.<name>=<host_path>:<container_path>[:<mode>]
#
# Mounts are read-only by default. Append :rw for read-write access.
#
# Common examples:
#   mount.gitconfig=~/.gitconfig:/home/coder/.gitconfig
#   mount.gitignore_global=~/.config/git/gitignore_global:/home/coder/.config/git/gitignore_global
#   mount.composio=~/.composio:/home/coder/.composio:rw

# ============================================
# Secrets (env file only)
# ============================================
# There is no per-variable passthrough: every secret goes in setting.env_file
# (dotenv KEY=VALUE lines, mode 600, under ~/.config/opencode-dockerized/).
# Use 'opencode-dockerized install' to add keys without ever printing them.
#
# Example file content (~/.config/opencode-dockerized/env, NOT this file):
#   EXA_API_KEY=...
#   OPENCODE_API_KEY=...
